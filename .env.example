POSTGRES_USER=asmrlsp
POSTGRES_PASSWORD=asmrlsp_dev
POSTGRES_DB=asmrlsp
# If host port 5432 is already taken on the server, use e.g. 5433
POSTGRES_HOST_PORT=5432
PGADMIN_DEFAULT_EMAIL=admin@local.dev
PGADMIN_DEFAULT_PASSWORD=asmrlsp_dev
PGADMIN_PORT=5050
# Used by local scripts; Compose builds DATABASE_URL for backend from POSTGRES_* above.
# Do not set host to localhost for Docker — backend connects to service "postgres".
DATABASE_URL=postgresql+asyncpg://asmrlsp:asmrlsp_dev@postgres:5432/asmrlsp
SECRET_KEY=change-me-in-production-use-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://172.20.10.7:5173,http://172.20.10.7:8080
SEED_DEMO_DATA=true
# Оставьте пустым: API/WS через прокси фронта. IP бэкенда не указывать.
VITE_API_URL=
